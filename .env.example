# Server
PORT=3000
AUTH_TOKEN=replace-with-a-long-random-secret
TMP_DIR=/tmp

# Database — use Railway Postgres (DATABASE_URL) OR Neon (NEON_DATABASE_URL)
DATABASE_URL=
# NEON_DATABASE_URL=

# Video rendering: ffmpeg = free built-in slides | creatomate = paid templates
VIDEO_RENDERER=ffmpeg

# Encryption for channel OAuth secrets at rest (64-char hex or any passphrase)
ENCRYPTION_KEY=

# Shared platform API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Only needed if VIDEO_RENDERER=creatomate
CREATOMATE_API_KEY=
CREATOMATE_THUMBNAIL_TEMPLATE_ID=
CREATOMATE_POLL_INTERVAL_MS=5000
CREATOMATE_POLL_TIMEOUT_MS=900000

# Webhooks (optional — Slack and/or Discord)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
WEBHOOK_NOTIFY_PENDING=true
WEBHOOK_NOTIFY_MONETIZATION=true
WEBHOOK_NOTIFY_PUBLISH=true
WEBHOOK_NOTIFY_FAILURE=true

# Default upload privacy for new videos (review before publish)
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=28

# Retry policy
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
