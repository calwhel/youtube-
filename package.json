{
  "name": "youtube-video-pipeline",
  "version": "2.0.0",
  "description": "Multi-tenant automated YouTube video generation and upload pipeline for Railway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/db dist/fonts && cp src/db/schema.sql dist/db/schema.sql && cp src/db/migrations.sql dist/db/migrations.sql && cp assets/fonts/DejaVuSans-Bold.ttf dist/fonts/DejaVuSans-Bold.ttf && vite build --config dashboard/vite.config.ts",
    "build:server": "tsc && mkdir -p dist/db dist/fonts && cp src/db/schema.sql dist/db/schema.sql && cp src/db/migrations.sql dist/db/migrations.sql && cp assets/fonts/DejaVuSans-Bold.ttf dist/fonts/DejaVuSans-Bold.ttf",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "get-token": "ts-node scripts/get-refresh-token.ts",
    "setup": "ts-node scripts/setup.ts",
    "setup-check": "ts-node scripts/setup-check.ts",
    "bootstrap-db": "ts-node scripts/bootstrap-db.ts",
    "create-channel": "ts-node scripts/create-channel.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.469.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
