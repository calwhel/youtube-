# Railway Variables — beginner setup (no Neon, no Creatomate)
#
# STEP 1: In Railway project click "+ New" → "Database" → "PostgreSQL"
# STEP 2: Click your APP service → Variables → "Add Reference" → Postgres → DATABASE_URL
# STEP 3: Add the variables below

# Dashboard login password — set once, NEVER change after connecting channels
AUTH_TOKEN=

# Encrypts YouTube OAuth tokens in Postgres — set once, NEVER change after connecting channels
ENCRYPTION_KEY=

VIDEO_RENDERER=ffmpeg
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-4-6 if unset
# ANTHROPIC_MODEL=claude-sonnet-4-6
ELEVENLABS_API_KEY=

# DATABASE_URL — link from Railway Postgres (do not paste manually if using Reference)

# Optional
YOUTUBE_PRIVACY_STATUS=private
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Only if you later switch to Creatomate:
# VIDEO_RENDERER=creatomate
# CREATOMATE_API_KEY=

# YouTube channel credentials are saved via the Connect page in the dashboard — not here.
# Re-logging into the dashboard does NOT require reconnecting YouTube.
