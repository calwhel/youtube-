# Paste these into Railway → your service → Variables (one time)
# Then connect GitHub repo — every push to main auto-deploys via Dockerfile

AUTH_TOKEN=
ENCRYPTION_KEY=
NEON_DATABASE_URL=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
CREATOMATE_API_KEY=

# Optional
CREATOMATE_THUMBNAIL_TEMPLATE_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
YOUTUBE_PRIVACY_STATUS=private

# PUBLIC_BASE_URL is auto-set by Railway — leave blank
